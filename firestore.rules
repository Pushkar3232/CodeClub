rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      // Users can read and write their own document
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow authenticated users to read other users' profiles for team matching
      // (needed for finding team members and viewing profiles)
      allow read: if request.auth != null;
    }
    
    // Teams collection
    match /teams/{teamId} {
      // Allow authenticated users to read all teams (for browsing/searching)
      allow read: if request.auth != null;
      
      // Allow creation of new teams - use request.resource.data for new documents
      allow create: if request.auth != null && 
                      request.auth.uid == request.resource.data.createdBy &&
                      request.auth.uid in request.resource.data.memberIds;
      
      // Team members can update/delete their team
      allow update, delete: if request.auth != null && 
                               request.auth.uid in resource.data.memberIds;
    }
    
    // Team requests collection
    match /teamRequests/{requestId} {
      // Allow authenticated users to read requests
      allow read: if request.auth != null;
      
      // Users can create requests - use request.resource.data for new documents
      allow create: if request.auth != null && 
                      request.auth.uid == request.resource.data.fromUserId;
      
      // Allow updates/deletes by sender or receiver
      allow update, delete: if request.auth != null && 
                               (request.auth.uid == resource.data.fromUserId ||
                                request.auth.uid == resource.data.toUserId);
    }
    
    // Hackathons collection - everyone can read, only admins can write
    match /hackathons/{hackathonId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
                      request.auth.token.admin == true;
    }
    
    // Chats collection
    match /chats/{chatId} {
      // Allow creation of new chats
      allow create: if request.auth != null && 
                      request.auth.uid in request.resource.data.participantIds;
      
      // Users can read/write chats they are participants of
      allow read, update, delete: if request.auth != null && 
                                     request.auth.uid in resource.data.participantIds;
    }
    
    // Messages subcollection
    match /chats/{chatId}/messages/{messageId} {
      // Chat participants can read messages
      allow read: if request.auth != null && 
                     request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      
      // Authenticated users can create messages if they're in the chat
      allow create: if request.auth != null && 
                       request.auth.uid == request.resource.data.senderId &&
                       request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
    }
  }
}